/target
**/*.rs.bk
.DS_Store

# vagus runtime state never lives in the repo (it lives in ~/.local/share/vagus and
# ~/Library/Caches/vagus). Guard against accidental local copies:
/.fastembed_cache
*.sqlite
*.sqlite-*

# Claude Code (ADR 0018 / G21): the global ~/.gitignore ignores .claude/ wholesale. Override here so
# only project settings and the repository writing skill are tracked. Keep per-agent worktrees
# and machine-local overrides ignored.
!.claude/
.claude/*
!.claude/settings.json

!.claude/skills/
.claude/skills/*
!.claude/skills/succinct-docs/
